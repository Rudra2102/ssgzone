# SSGzone Communication Platform — Environment Variables Reference
# =================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.
# =================================================================

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ssgzone_mail
DB_USER=postgres
# Use a strong random password — minimum 32 characters
# Generate: openssl rand -base64 32
DB_PASSWORD=

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── API Gateway ──────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development

# JWT Secret — MUST be cryptographically random, minimum 64 hex chars
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4002

# ── Domain ───────────────────────────────────────────────────
DOMAIN=ssgzone.in

# ── Webmail ──────────────────────────────────────────────────
WEBMAIL_PORT=4002

# ── AWS / SES ────────────────────────────────────────────────
# Create a new IAM user with SES SendEmail permission only (least privilege)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
SES_FROM_EMAIL=noreply@ssgzone.in
SES_FROM_NAME=SSGzone

# ── MinIO / Object Storage ───────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=
# Minimum 16 characters
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_EMAILS=ssgzone-emails
MINIO_BUCKET_ATTACHMENTS=ssgzone-attachments
MINIO_BUCKET_BACKUPS=ssgzone-backups

# ── Cloudflare ───────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=

# ── Encryption Key ───────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── SSL/TLS ──────────────────────────────────────────────────
SSL_ENABLED=false
# SSL_CERT_PATH=/etc/ssl/certs/ssgzone.in.crt
# SSL_KEY_PATH=/etc/ssl/private/ssgzone.in.key

# ── DKIM ─────────────────────────────────────────────────────
# DKIM_PRIVATE_KEY_PATH=/etc/dkim/ssgzone.in.private
# DKIM_SELECTOR=default

# ── Monitoring ───────────────────────────────────────────────
LOG_LEVEL=info
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
